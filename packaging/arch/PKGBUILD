# Maintainer: zenthora <105382125+zenthora@users.noreply.github.com>
pkgname=zpane
pkgver=0.6.0
pkgrel=1
pkgdesc="Blazing-fast 3-pane Miller Column Command, Subcommand, Parameter & Variable Explorer for PowerShell and POSIX shells"
arch=('x86_64' 'aarch64')
url="https://github.com/zenthora/zpane"
license=('MIT')
depends=('gcc-libs')
makedepends=('cargo')
optdepends=('powershell: PowerShell cmdlet and parameter-set reflection')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Security: pin the source tarball SHA-256 digest when publishing a tagged release or AUR update.
sha256sums=('SKIP')

prepare() {
    cd "$srcdir/$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
    cd "$srcdir/$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release --all-features
}

check() {
    cd "$srcdir/$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo test --frozen --all-features
}

package() {
    umask 022
    cd "$srcdir/$pkgname-$pkgver"
    install -d -m0755 \
        "$pkgdir/usr/bin" \
        "$pkgdir/usr/share/licenses/$pkgname" \
        "$pkgdir/usr/share/doc/$pkgname"
    install -Dm0755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
    install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm0644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
